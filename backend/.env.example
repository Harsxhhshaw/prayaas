# PRAYAAS Backend Environment Configuration
APP_ENV=development
APP_DEBUG=true
APP_TITLE="PRAYAAS Geospatial Intelligence API"

# Database Connection
DATABASE_URL=postgresql+psycopg://prayaas:change-me@localhost:5432/prayaas
POSTGRES_DB=prayaas
POSTGRES_USER=prayaas
POSTGRES_PASSWORD=change-me

# Allowed CORS Origins (e.g. ["http://localhost:5173", "https://prayaas.vercel.app"])
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional Document AI / LLM Configuration (disabled by default)
DOCUMENT_AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
