# PRAYAAS Backend Environment Configuration
APP_ENV=production
APP_DEBUG=false
APP_TITLE="PRAYAAS Geospatial Intelligence API"

# Database Connection (Render sets this automatically when attached to a Render PostgreSQL service)
DATABASE_URL=postgresql+psycopg://prayaas:prayaas@localhost:5432/prayaas

# Allowed CORS Origins (Set to your Vercel deployment URL, e.g. ["https://prayaas.vercel.app"] or ["*"])
CORS_ORIGINS=["*"]
