# ============================================================
# PRAYAAS Environment Configuration Example
# ============================================================

# Frontend (Vite)
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production deployment (e.g. Vercel):
# VITE_API_BASE_URL=https://<your-render-backend-name>.onrender.com

# Backend (FastAPI / PostgreSQL / PostGIS)
APP_ENV=development
APP_DEBUG=true
APP_TITLE="PRAYAAS Geospatial Intelligence API"
DATABASE_URL=postgresql+psycopg://prayaas:change-me@localhost:5432/prayaas
POSTGRES_DB=prayaas
POSTGRES_USER=prayaas
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional Document AI / LLM Extraction (disabled by default)
DOCUMENT_AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
